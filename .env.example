# ============================================================
# data-analysis-agent 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 gitignore，禁止入库。
# ============================================================

# ---------- MySQL（MCP Server 只读账户，安全底线） ----------
# 初始化（本机 MySQL 手动执行，纯新增）：
#   mysql -u root -p < deploy/docker/mysql-init/01-init.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mcp_reader
MYSQL_PASSWORD=mcp_reader_pw
MYSQL_DATABASE=analytics
# MYSQL_DATABASE 留空 = 多库模式（list_resources 列出所有用户库）
MYSQL_SSL_MODE=DISABLED
MYSQL_CONNECT_TIMEOUT=10

# ---------- MCP Server（自研 app/mcp/server.py） ----------
# 传输模式：stdio = 开发/POC（子进程）；streamable-http = 生产独立服务（Day 4）
MCP_TRANSPORT=stdio
# streamable-http 监听地址（Day 4 启用；公网暴露必须前置反代 + API Key 认证）
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8000
# 连接池大小（规范要求 20-50）与查询护栏
MYSQL_POOL_SIZE=20
# PII 脱敏开关（数据离开 MCP Server 前掩码 name/phone 等列；生产保持 true）
PII_MASKING=true
# MCP Server API Key（生产网关认证用：nginx map 校验 Authorization: Bearer；本地开发可空）
MCP_API_KEY=

# ---------- Redis（缓存/限流，Day 4 接入） ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Postgres（分布式 Checkpointer，Day 1 验证） ----------
POSTGRES_DSN=postgresql://agent:agent_pw@127.0.0.1:5432/agent_state

# ---------- DeepSeek（Reasonix CLI 侧使用，api_key_env 注入，不写入配置文件） ----------
DEEPSEEK_API_KEY=

# ---------- 应用层（Day 2+） ----------
APP_PORT=8080
# SQL 查询超时（秒）与返回行数上限，防止慢查询拖垮服务
QUERY_TIMEOUT_SECONDS=30
MAX_ROWS_RETURN=1000
